<%- include('partials/header') %><section class="page-section compact-section"><div class="form-panel wide-form"><div class="page-heading left-heading"><span>Admin</span><h1><%= mode === 'add' ? 'Add New Car' : 'Edit Car' %></h1><p><%= mode === 'add' ? 'Upload a vehicle image and complete all listing details.' : 'Update listing information or replace its image.' %></p></div><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="post" action="<%= mode === 'add' ? '/admin/cars' : '/admin/cars/'+car._id %>" enctype="multipart/form-data" class="app-form two-column-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Brand<input type="text" name="brand" value="<%= car.brand || '' %>" required maxlength="100"></label><label>Model<input type="text" name="model" value="<%= car.model || '' %>" required maxlength="100"></label><label>Year<input type="number" name="year" value="<%= car.year || currentYear %>" min="1900" max="<%= currentYear+1 %>" required></label><label>Price (PKR)<input type="number" name="price" value="<%= car.price ?? '' %>" min="0" step="0.01" required></label><label>Status<select name="status"><% ['available','booked','sold'].forEach((option) => { %><option value="<%= option %>" <%= car.status === option ? 'selected' : '' %>><%= option[0].toUpperCase()+option.slice(1) %></option><% }) %></select></label><label>Car Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" <%= mode === 'add' ? 'required' : '' %>><small>JPG, PNG, WEBP, or AVIF; maximum 5 MB.<%= mode === 'edit' ? ' Leave empty to keep current image.' : '' %></small></label><label class="full-field">Description<textarea name="description" rows="5" maxlength="2000"><%= car.description || '' %></textarea></label><div class="full-field card-actions"><button class="btn btn-primary" type="submit"><%= mode === 'add' ? 'Add Car' : 'Save Changes' %></button><a class="btn btn-secondary" href="<%= mode === 'add' ? '/inventory' : '/cars/'+car._id %>">Cancel</a></div></form></div></section><%- include('partials/footer') %>
