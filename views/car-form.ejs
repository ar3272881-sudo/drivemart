<%- include('partials/header') %><section class="page-section compact-section"><div class="form-panel wide-form"><div class="page-heading left-heading"><span>Admin</span><h1><%= mode === 'add' ? 'Add New Car' : 'Edit Car' %></h1><p><%= mode === 'add' ? 'Upload a vehicle image and complete all listing details.' : 'Update listing information or replace its image.' %></p></div><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="post" action="<%= mode === 'add' ? '/admin/cars' : '/admin/cars/'+car._id %>" enctype="multipart/form-data" class="app-form two-column-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>City / Location<input name="city" maxlength="80" value="<%= car.city || '' %>" placeholder="e.g. Lahore"></label><label>Brand<input type="text" name="brand" value="<%= car.brand || '' %>" required maxlength="100"></label><label>Model<input type="text" name="model" value="<%= car.model || '' %>" required maxlength="100"></label><label>Year<input type="number" name="year" value="<%= car.year || currentYear %>" min="1900" max="<%= currentYear+1 %>" required></label><label>Price (PKR)<input type="number" name="price" value="<%= car.price ?? '' %>" min="0" step="0.01" required></label><label>Status<select name="status"><% ['available','booked','sold'].forEach((option) => { %><option value="<%= option %>" <%= car.status === option ? 'selected' : '' %>><%= option[0].toUpperCase()+option.slice(1) %></option><% }) %></select></label><label>Car Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" <%= mode === 'add' ? 'required' : '' %>><small>JPG, PNG, WEBP, or AVIF; maximum 5 MB.<%= mode === 'edit' ? ' Leave empty to keep current image.' : '' %></small></label><label>Color<input name="color" maxlength="60" value="<%= car.color||'' %>"></label><label>Mileage (km)<input name="mileage" type="number" min="0" max="2000000" value="<%= car.mileage??0 %>"></label><label>Condition<select name="condition"><% ['excellent','good','fair','needs_work'].forEach(item=>{ %><option value="<%= item %>" <%= car.condition===item?'selected':'' %>><%= item %></option><% }) %></select></label><label>Fuel Type<select name="fuelType"><% ['','petrol','diesel','hybrid','electric','cng','lpg'].forEach(item=>{ %><option value="<%= item %>" <%= car.fuelType===item?'selected':'' %>><%= item||'Select' %></option><% }) %></select></label><label>Transmission<select name="transmission"><% ['','manual','automatic'].forEach(item=>{ %><option value="<%= item %>" <%= car.transmission===item?'selected':'' %>><%= item||'Select' %></option><% }) %></select></label><label>Body Type<select name="bodyType"><% ['','sedan','hatchback','suv','pickup','van','coupe','other'].forEach(item=>{ %><option value="<%= item %>" <%= car.bodyType===item?'selected':'' %>><%= item||'Select' %></option><% }) %></select></label><label>Engine CC<input name="engineCC" type="number" min="0" max="20000" value="<%= car.engineCC||0 %>"></label><label>Gallery Images (up to 4 additional, max 5MB each)<input type="file" name="gallery" multiple accept="image/jpeg,image/png,image/webp,image/avif"></label><label>Latitude (optional)<input type="number" name="latitude" step="any" min="-90" max="90" value="<%= car.location?.coordinates?.[1]??'' %>"></label><label>Longitude (optional)<input type="number" name="longitude" step="any" min="-180" max="180" value="<%= car.location?.coordinates?.[0]??'' %>"></label><% if(mode==='edit' && car.gallery?.length){ %><fieldset class="full-field"><legend>Current gallery images (select to remove)</legend><div class="enhanced-image-strip"><% car.gallery.forEach(img=>{ %><label><img src="<%= imageSrc(img.url) %>" alt="Gallery image"><input type="checkbox" name="removeGallery" value="<%= img.url %>">Remove</label><% }) %></div></fieldset><% } %><label class="full-field">Description<textarea name="description" rows="5" maxlength="2000"><%= car.description || '' %></textarea></label><div class="full-field card-actions"><button class="btn btn-primary" type="submit"><%= mode === 'add' ? 'Add Car' : 'Save Changes' %></button><a class="btn btn-secondary" href="<%= mode === 'add' ? '/inventory' : '/cars/'+car._id %>">Cancel</a></div></form></div></section><%- include('partials/footer') %>
