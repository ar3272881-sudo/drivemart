<%- include('partials/header') %><section class="page-section"><div class="page-heading split-heading"><div><span>Premium Collection</span><h1>Drive Mart Inventory</h1><p>Search by brand or model and view complete vehicle details.</p></div><% if (isAdmin) { %><a class="btn btn-primary" href="/admin/cars/new"><i class="fa-solid fa-plus"></i> Add Car</a><% } %></div>
<form method="get" class="filter-bar"><input type="search" name="search" value="<%= search %>" placeholder="Search brand, model, or description"><select name="status"><option value="">All statuses</option><% allowedStatuses.forEach((option) => { %><option value="<%= option %>" <%= status === option ? 'selected' : '' %>><%= option[0].toUpperCase()+option.slice(1) %></option><% }) %></select><button class="btn btn-primary" type="submit">Search</button><a class="btn btn-secondary" href="/inventory">Reset</a></form>
<div class="inventory-grid"><% if (!cars.length) { %><div class="empty-state"><i class="fa-solid fa-car"></i><h2>No cars found</h2><p>Try a different search or status.</p></div><% } %><% cars.forEach((car) => { %><article class="inventory-card"><div class="inventory-image"><img src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><span class="status-badge status-<%= car.status %>"><%= car.status[0].toUpperCase()+car.status.slice(1) %></span></div><div class="inventory-content"><span class="brand-label"><%= car.brand %></span><h2><%= car.model %></h2><div class="car-meta"><span><%= car.year %></span><span>PKR <%= formatMoney(car.price) %></span></div><p><%= car.description %></p><div class="card-actions"><a class="btn btn-primary" href="/cars/<%= car._id %>">View Details</a><% if (isAdmin) { %><a class="btn btn-secondary" href="/admin/cars/<%= car._id %>/edit">Edit</a><form method="post" action="/admin/cars/<%= car._id %>/delete" onsubmit="return confirm('Delete this car and its bookings?');"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-danger" type="submit">Delete</button></form><% } %></div></div></article><% }) %></div></section><%- include('partials/footer') %>
