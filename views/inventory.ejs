<%- include('partials/header') %><section class="page-section">
<div class="page-heading split-heading"><div><span>Vehicle Marketplace</span><h1>Drive Mart Inventory</h1><p id="inventoryCount"><%= count %> vehicles match the current filters.</p></div><% if(isAdmin){ %><a class="btn btn-primary" href="/admin/cars/new">+ Add Car</a><% } %></div>
<form method="get" id="inventoryFilter" class="filter-bar enhanced-filter"><label>Search<input type="search" name="search" value="<%= search %>" placeholder="Brand, model, description"></label>
<label>Brand<select name="brand"><option value="">All brands</option><% brands.forEach(option=>{ %><option value="<%= option %>" <%= brand===option?'selected':'' %>><%= option %></option><% }) %></select></label>
<label>City<input name="city" maxlength="80" value="<%= city %>" placeholder="Lahore"></label>
<label>Status<select name="status"><option value="">All</option><% allowedStatuses.forEach(option=>{ %><option value="<%= option %>" <%= status===option?'selected':'' %>><%= option %></option><% }) %></select></label>
<label>Min price<input type="number" min="0" name="minPrice" value="<%= minPrice %>"></label><label>Max price<input type="number" min="0" name="maxPrice" value="<%= maxPrice %>"></label>
<label>From year<input type="number" min="1900" max="<%= currentYear+1 %>" name="minYear" value="<%= minYear %>"></label><label>To year<input type="number" min="1900" max="<%= currentYear+1 %>" name="maxYear" value="<%= maxYear %>"></label>
<label>Max mileage (km)<input type="number" min="0" name="maxMileage" value="<%= maxMileage %>"></label>
<label>Fuel<select name="fuelType"><option value="">Any</option><% ['petrol','diesel','hybrid','electric','cng','lpg'].forEach(option=>{ %><option value="<%= option %>" <%= fuelType===option?'selected':'' %>><%= option %></option><% }) %></select></label>
<label>Gearbox<select name="transmission"><option value="">Any</option><% ['manual','automatic'].forEach(option=>{ %><option value="<%= option %>" <%= transmission===option?'selected':'' %>><%= option %></option><% }) %></select></label>
<label>Body<select name="bodyType"><option value="">Any</option><% ['sedan','hatchback','suv','pickup','van','coupe','other'].forEach(option=>{ %><option value="<%= option %>" <%= bodyType===option?'selected':'' %>><%= option %></option><% }) %></select></label>
<label>Sort<select name="sort"><% [['newest','Newest'],['price_asc','Lowest price'],['price_desc','Highest price'],['year_desc','Newest model'],['popular','Most viewed']].forEach(opt=>{ %><option value="<%= opt[0] %>" <%= sort===opt[0]?'selected':'' %>><%= opt[1] %></option><% }) %></select></label>
<fieldset class="nearby-fields"><legend>Nearby search (only cars with coordinates)</legend><label>Latitude<input id="nearLat" type="number" step="any" min="-90" max="90" name="lat" value="<%= lat %>"></label><label>Longitude<input id="nearLng" type="number" step="any" min="-180" max="180" name="lng" value="<%= lng %>"></label><label>Radius (km)<input type="number" min="1" max="500" name="distance" value="<%= distance %>"></label><button id="findLocation" type="button" class="btn btn-secondary">Use My Location</button></fieldset>
<button class="btn btn-primary">Apply Filters</button><a href="/inventory" class="btn btn-secondary">Reset</a>
</form>
<div class="inventory-grid" id="inventoryResults"><% if(!cars.length){ %><div class="empty-state"><h2>No cars found</h2><p>Try broadening your filters. Nearby search requires coordinates in the car listing.</p></div><% } %>
<% cars.forEach(car=>{ %><article class="inventory-card"><div class="inventory-image"><img src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><span class="status-badge status-<%= car.status %>"><%= car.status %></span></div><div class="inventory-content"><span class="brand-label"><%= car.brand %></span><h2><%= car.model %></h2><p><%= car.city||'Pakistan' %> • <%= car.year %> • <%= car.mileage||0 %> km</p><p>PKR <%= formatMoney(car.price) %></p><p><%= car.fuelType||'Fuel not specified' %> • <%= car.transmission||'Gearbox not specified' %></p><div class="card-actions"><a class="btn btn-primary" href="/cars/<%= car._id %>">Details</a><% if(isAdmin){ %><a class="btn btn-secondary" href="/admin/cars/<%= car._id %>/edit">Edit</a><% } %></div></div></article><% }) %></div>
<% if(totalPages>1){ %><nav id="inventoryPagination" class="pagination" aria-label="Results pages"><% for(let n=Math.max(1,page-2);n<=Math.min(totalPages,page+2);n++){const params=new URLSearchParams({...queryParams,page:String(n)}); %><a class="btn <%= n===page?'btn-primary':'btn-secondary' %>" href="/inventory?<%= params.toString() %>"><%= n %></a><% } %></nav><% } %>
</section><script>document.getElementById('findLocation').addEventListener('click',()=>{if(!navigator.geolocation){alert('Your browser does not support geolocation.');return}navigator.geolocation.getCurrentPosition(pos=>{document.getElementById('nearLat').value=pos.coords.latitude;document.getElementById('nearLng').value=pos.coords.longitude;document.querySelector('[name="distance"]').value||=25},()=>alert('Location permission not available. Enter coordinates manually.'),{timeout:10000})})</script><script src="/advanced-filters.js" defer></script><%- include('partials/footer') %>
