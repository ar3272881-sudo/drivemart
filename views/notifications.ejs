<%- include('partials/header') %><section class="page-section compact-section"><div class="page-heading split-heading"><div><span>Activity</span><h1>Notifications</h1></div><form method="post" action="/notifications/read-all"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-secondary">Mark all read</button></form></div><div class="notification-feed"><% if(!notifications.length){ %><p>No notifications yet.</p><% } %><% notifications.forEach(n=>{ %><form method="post" action="/notifications/<%= n._id %>/read" class="notification-entry <%= n.readAt?'':'unread' %>"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button type="submit" class="notification-button"><strong><%= n.type.toUpperCase() %></strong> <%= n.text %><small><%= formatDate(n.createdAt,true) %> — <%= n.readAt?'Read':'Unread • Open' %></small></button></form><% }) %></div></section><%- include('partials/footer') %>
