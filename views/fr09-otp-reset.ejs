<%- include('partials/header') %><section class="page-section feature-panel"><h1>Reset Password Using Email Code</h1><% if(error){ %><div class="form-error"><%= error %></div><% } %><form method="post" action="/reset-password-otp" class="app-form"><input name="csrf_token" type="hidden" value="<%= csrfToken %>"><label>Email<input type="email" name="email" value="<%= email %>" required></label><label>6-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"></label><label>New password (8+ characters)<input type="password" name="password" minlength="8" maxlength="128" required></label><button class="btn btn-primary">Reset Password</button></form><p><a href="/forgot-password">Request another code</a></p></section><%- include('partials/footer') %>