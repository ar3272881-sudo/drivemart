<%- include('partials/header') %><section class="page-section compact-section"><div class="detail-layout"><div class="detail-image-wrap"><img src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><span class="status-badge status-<%= car.status %>"><%= car.status[0].toUpperCase()+car.status.slice(1) %></span></div><div class="detail-content"><span class="brand-label"><%= car.brand %></span><h1><%= car.model %></h1><p class="detail-price">PKR <%= formatMoney(car.price) %></p><div class="detail-specs"><div><span>Model Year</span><strong><%= car.year %></strong></div><div><span>Status</span><strong><%= car.status[0].toUpperCase()+car.status.slice(1) %></strong></div></div><div class="detail-description"><h3>Description</h3><p><%= car.description %></p></div><div class="card-actions"><% if (car.status === 'available') { %><a class="btn btn-primary" href="/cars/<%= car._id %>/book">Book Now</a><% } else { %><button class="btn btn-disabled" type="button" disabled>Currently <%= car.status %></button><% } %><a class="btn btn-secondary" href="/inventory">Back to Inventory</a><% if (isAdmin) { %><a class="btn btn-secondary" href="/admin/cars/<%= car._id %>/edit">Edit Car</a><% } %></div></div></div></section><%- include('partials/footer') %>
