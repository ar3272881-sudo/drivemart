<%- include('partials/header') %><section class="page-section compact-section"><div class="detail-layout"><div class="detail-image-wrap"><img id="carMainPhoto" src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>">
<% if(car.gallery?.length){ %><div class="enhanced-image-strip gallery-thumbs"><button type="button" data-photo="<%= imageSrc(car.image) %>"><img src="<%= imageSrc(car.image) %>" alt="Cover"></button><% car.gallery.forEach((photo,i)=>{ %><button type="button" data-photo="<%= imageSrc(photo.url) %>"><img src="<%= imageSrc(photo.url) %>" alt="Gallery <%= i+1 %>"></button><% }) %></div><% } %><span class="status-badge status-<%= car.status %>"><%= car.status[0].toUpperCase()+car.status.slice(1) %></span></div><div class="detail-content"><span class="brand-label"><%= car.brand %></span><h1><%= car.model %></h1><p class="detail-price">PKR <%= formatMoney(car.price) %></p><div class="detail-specs"><div><span>Model Year</span><strong><%= car.year %></strong></div><div><span>Status</span><strong><%= car.status[0].toUpperCase()+car.status.slice(1) %></strong></div></div><p class="detail-more-specs">Mileage: <%= formatMoney(car.mileage||0) %> km • Fuel: <%= car.fuelType||'Not given' %> • Gearbox: <%= car.transmission||'Not given' %> • Body: <%= car.bodyType||'Not given' %> • Engine: <%= car.engineCC||'Not given' %> CC</p>
<% if(currentUser && (car.approvalStatus==='approved'||!car.approvalStatus)){ %><form method="post" action="/cars/<%= car._id %>/favorite"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button type="submit" class="btn btn-secondary"><%= isFavorite?'♥ Remove from Favorites':'♡ Save to Favorites' %></button></form><% } %>
<div class="detail-description"><h3>Description</h3><p><%= car.description %></p></div><% if(car.city){ %><p>Location: <%= car.city %></p><% } %><div class="card-actions"><% if (car.approvalStatus === 'approved' || !car.approvalStatus) { %><% if (car.status === 'available') { %><a class="btn btn-primary" href="/cars/<%= car._id %>/book">Book Now</a><% } else { %><button class="btn btn-disabled" type="button" disabled>Currently <%= car.status %></button><% } %><% } else { %><span class="status-badge status-pending">Awaiting admin approval</span><% } %><a class="btn btn-secondary" href="/inventory">Back to Inventory</a><% if (isAdmin) { %><a class="btn btn-secondary" href="/admin/cars/<%= car._id %>/edit">Edit Car</a><% } %></div></div></div><% if(currentUser && car.seller && String(car.seller)!==String(currentUser.id) && car.approvalStatus==='approved' && !car.hiddenByAdmin){ %><section class="feature-panel"><h2>Contact Seller (FR06)</h2><a class="btn btn-primary" href="/chat/<%= car._id %>">Chat with Seller</a><h2>Make an Offer (FR07)</h2><form method="post" action="/cars/<%= car._id %>/bids" class="app-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Offer amount (PKR)<input name="amount" type="number" min="1" max="10000000000" required></label><button class="btn btn-primary">Send Bid</button></form></section><% } %><% if (currentUser) { %><div class="ai-tool-panel detail-estimate" style="max-width:1180px;margin:32px auto"><h2>Gemini AI Car Price Estimator</h2><p class="privacy-hint">Indicative AI-generated price, not a verified current market quote.</p><form id="detailEstimateForm" class="app-form two-column-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Brand<input name="brand" value="<%= car.brand %>" required></label><label>Model<input name="model" value="<%= car.model %>" required></label><label>Year<input name="year" type="number" value="<%= car.year %>" required></label><label>Mileage (km)<input name="mileage" type="number" value="<%= car.mileage || 0 %>" required></label><label>Condition<select name="condition"><% ['excellent','good','fair','needs_work'].forEach(x => { %><option value="<%= x %>" <%= car.condition === x ? 'selected' : '' %>><%= x.replace('_',' ') %></option><% }) %></select></label><div class="full-field"><button type="button" id="detailEstimate" class="btn btn-secondary">Estimate Price</button><p id="detailEstimateResult" class="ai-feedback" role="status" aria-live="polite"></p></div></form></div><% } %></section><script>document.querySelectorAll('.gallery-thumbs [data-photo]').forEach(button=>button.addEventListener('click',()=>{document.getElementById('carMainPhoto').src=button.dataset.photo;}));</script>
<%- include('partials/footer') %>
