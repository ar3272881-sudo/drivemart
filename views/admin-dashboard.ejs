<%- include('partials/header') %><section class="page-section"><div class="page-heading split-heading"><div><span>Administration</span><h1>Drive Mart Dashboard</h1><p>Manage inventory, customers, and booking requests.</p></div><a class="btn btn-primary" href="/admin/cars/new"><i class="fa-solid fa-plus"></i> Add Car</a></div><div class="admin-stat-grid"><article class="admin-stat"><i class="fa-solid fa-users"></i><h2><%= stats.users %></h2><p>Registered Users</p></article><article class="admin-stat"><i class="fa-solid fa-car"></i><h2><%= stats.cars %></h2><p>Total Cars</p></article><article class="admin-stat"><i class="fa-solid fa-calendar-check"></i><h2><%= stats.bookings %></h2><p>Total Bookings</p></article><article class="admin-stat"><i class="fa-solid fa-clock"></i><h2><%= stats.pending %></h2><p>Pending Requests</p></article></div><div class="admin-quick-links"><a class="btn btn-secondary" href="/inventory">Manage Cars</a><a class="btn btn-secondary" href="/admin/bookings">Manage Bookings</a><a class="btn btn-secondary" href="/">View Website</a></div><div class="table-panel"><div class="table-panel-heading"><h2>Recent Bookings</h2><a href="/admin/bookings">View all</a></div><div class="table-scroll"><table class="app-table"><thead><tr><th>User</th><th>Car</th><th>Phone</th><th>Preferred Date</th><th>Status</th></tr></thead><tbody><% if (!recent.length) { %><tr><td colspan="5">No bookings found.</td></tr><% } %><% recent.forEach((row) => { %><tr><td><%= row.user?.name || 'Deleted user' %></td><td><%= row.car ? row.car.brand+' '+row.car.model : 'Deleted car' %></td><td><%= row.phone %></td><td><%= formatDate(row.preferredDate) %></td><td><span class="status-badge status-<%= row.status %>"><%= row.status[0].toUpperCase()+row.status.slice(1) %></span></td></tr><% }) %></tbody></table></div></div></section><%- include('partials/footer') %>
