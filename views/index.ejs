<%- include('partials/header', { bodyClass: '' }) %>
<div class="particles"></div>
<section class="hero" id="home"><div class="hero-content"><span>Premium Car Marketplace</span><h1>Find Your Dream Car Today</h1><p>Luxury. Performance. Comfort. All in one place.</p><div class="hero-buttons"><a href="/inventory"><button class="primary">Explore Cars</button></a><a href="mailto:info@drivemart.com?subject=Sell%20My%20Car"><button class="secondary">Sell Your Car</button></a></div></div><div class="hero-image"><img src="/img/download-bmw-car-png-image-0.png" alt="Premium red BMW"></div></section>
<section class="featured" id="featured"><div class="section-title"><span>OUR COLLECTION</span><h2>Featured Luxury Cars</h2><p>Choose from our premium collection of luxury, sports and family cars.</p></div><div class="cars-grid">
<% if (!featured.length) { %><div class="empty-state"><h3>No available cars at the moment.</h3></div><% } %>
<% featured.forEach((car) => { %><div class="car-card"><div class="car-image"><img src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><div class="price-tag">PKR <%= formatMoney(car.price) %></div><div class="wishlist">❤</div></div><div class="car-content"><span class="brand"><%= car.brand %></span><h3><%= car.model %> (<%= car.year %>)</h3><div class="rating">★★★★★</div><div class="car-info"><span>🚗 Premium Car</span><span>📅 <%= car.year %></span></div><a href="/cars/<%= car._id %>"><button>View Details</button></a></div></div><% }) %>
</div><div class="section-cta"><a class="btn btn-primary" href="/inventory">View Full Inventory</a></div></section>
<section class="brands" id="brands"><div class="brands-title"><span>TOP BRANDS</span><h2>Popular Car Brands</h2><p>Choose your favourite automobile brand.</p></div><div class="brand-grid"><% [['BMW','Luxury Cars'],['Mercedes','Premium Cars'],['Audi','German Quality'],['Ferrari','Sports Cars'],['Lamborghini','Super Cars'],['Porsche','Performance']].forEach((brand) => { %><a class="brand-card" href="/inventory?search=<%= encodeURIComponent(brand[0]) %>"><div class="brand-mark"><%= brand[0] %></div><h3><%= brand[0] %></h3><p><%= brand[1] %></p></a><% }) %></div></section>
<section class="why-us" id="services"><div class="why-title"><span>WHY CHOOSE US</span><h2>Why Drive Mart?</h2><p>We provide premium quality cars with trusted service and the best prices.</p></div><div class="why-grid"><div class="why-card"><div class="why-icon">🚗</div><h3>Premium Cars</h3><p>Choose from a wide collection of luxury and family vehicles.</p></div><div class="why-card"><div class="why-icon">🛡️</div><h3>Verified Listings</h3><p>Every listing is managed by the Drive Mart administration team.</p></div><div class="why-card"><div class="why-icon">💰</div><h3>Best Prices</h3><p>Compare transparent prices before submitting your booking.</p></div><div class="why-card"><div class="why-icon">🎧</div><h3>Customer Support</h3><p>Our support team is ready to help before and after booking.</p></div></div></section>
<section class="stats" id="about"><div class="stats-title"><span>OUR ACHIEVEMENTS</span><h2>Drive Mart In Numbers</h2><p>Customers trust Drive Mart for discovering and booking premium vehicles.</p></div><div class="stats-grid"><div class="stat-card"><div class="stat-icon">🚗</div><h2>5000+</h2><h3>Cars Sold</h3><p>Premium and family vehicles delivered across Pakistan.</p></div><div class="stat-card"><div class="stat-icon">😊</div><h2>3200+</h2><h3>Happy Customers</h3><p>Trusted by satisfied buyers nationwide.</p></div><div class="stat-card"><div class="stat-icon">⭐</div><h2>4.9</h2><h3>Customer Rating</h3><p>Highly rated for quality and customer support.</p></div><div class="stat-card"><div class="stat-icon">🏆</div><h2>15+</h2><h3>Years Experience</h3><p>Automotive services delivered with confidence.</p></div></div></section>
<section class="testimonials"><div class="testimonial-title"><span>TESTIMONIALS</span><h2>What Our Customers Say</h2><p>Real experiences from Drive Mart customers.</p></div><div class="testimonial-grid"><% [['AK','Ali Khan','Lahore','Buying my first car from Drive Mart was transparent and professional.'],['AR','Ahmed Raza','Karachi','Excellent customer support and genuine car listings.'],['UA','Usman Ali','Islamabad','The luxury collection is outstanding. I found my dream car here.']].forEach((t) => { %><div class="testimonial-card"><div class="client"><div class="client-avatar"><%= t[0] %></div><div class="client-info"><h3><%= t[1] %></h3><span><%= t[2] %></span></div></div><p class="review"><%= t[3] %></p><div class="verified">✔ Verified Customer</div></div><% }) %></div></section>
<section class="faq-section" id="faq"><div class="section-title"><span>HELP CENTER</span><h2>Frequently Asked Questions</h2><p>Quick answers about accounts and bookings.</p></div><div class="faq-list"><details><summary>How do I book a car?</summary><p>Create an account, open a car's details, click Book Now, and submit your phone number and preferred visit date.</p></details><details><summary>When is a booking confirmed?</summary><p>A new request starts as pending. It is confirmed when an administrator changes its status to approved.</p></details><details><summary>Can I cancel a booking?</summary><p>Yes. Open My Bookings and cancel any pending or approved request.</p></details><details><summary>How can I list a car for sale?</summary><p>Contact Drive Mart using the email or phone details below. Administrators can add verified listings.</p></details></div></section>
<section class="newsletter" id="newsletter"><div class="newsletter-box"><h2>Stay Updated</h2><p>Subscribe to receive the latest car deals and premium arrivals.</p><form class="news-form" method="post" action="/subscribe"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="email" name="email" placeholder="Enter your email address" required><button type="submit">Subscribe Now</button></form><img src="/img/download-bmw-car-png-image-0.png" class="news-car" alt="Car"></div></section>
<footer class="footer" id="contact"><div class="footer-container"><div><div class="footer-logo">Drive <span>Mart</span></div><p class="footer-about">Pakistan's premium car marketplace for discovering and booking luxury, family, and sports vehicles.</p><div class="social-icons"><a href="#"><i class="fab fa-facebook-f"></i></a><a href="#"><i class="fab fa-instagram"></i></a><a href="#"><i class="fab fa-x-twitter"></i></a><a href="#"><i class="fab fa-linkedin-in"></i></a></div></div><div><h3>Quick Links</h3><div class="footer-links"><a href="#home">Home</a><a href="/inventory">Inventory</a><a href="#brands">Brands</a><a href="#services">Services</a><a href="#faq">FAQ</a></div></div><div><h3>Account</h3><div class="footer-links"><% if (currentUser) { %><a href="/dashboard">Dashboard</a><a href="/bookings">My Bookings</a><form method="post" action="/logout"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="footer-link-button" type="submit">Logout</button></form><% } else { %><a href="/login">Login</a><a href="/register">Register</a><% } %></div></div><div><h3>Contact</h3><div class="footer-contact"><span>📍 Multan, Pakistan</span><span>📞 +92 300 1234567</span><span>📧 info@drivemart.com</span><span>🕒 Mon - Sat: 9AM - 8PM</span></div></div></div><div class="footer-bottom"><p>© <%= currentYear %> Drive Mart. All Rights Reserved.</p><div><a href="#faq">Help</a><a href="#contact">Contact</a></div></div></footer>
<div class="progress-bar"></div><div class="cursor-glow"></div><a href="https://wa.me/923001234567" class="whatsapp" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a><button class="scroll-top" type="button" aria-label="Scroll to top"><i class="fas fa-arrow-up"></i></button>
<%- include('partials/footer', { hideSimpleFooter: true }) %>
