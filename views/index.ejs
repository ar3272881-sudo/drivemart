<%- include('partials/header', { bodyClass: 'dm-home-page' }) %>
<main>
<section class="dm-hero" id="home" aria-labelledby="dm-hero-title">
  <div class="dm-hero-background"></div>
  <div class="dm-container dm-hero-inner">
    <div class="dm-hero-copy">
      <span class="dm-eyebrow dm-eyebrow-light"><i class="fa-solid fa-circle-check"></i> THE SMARTER CAR MARKETPLACE</span>
      <h1 id="dm-hero-title">Find The Perfect Car<br><strong>For Every Journey</strong></h1>
      <p>Explore vehicles across Pakistan, compare prices and connect with sellers—all in one place.</p>
      <div class="dm-hero-actions"><a class="btn btn-primary dm-hero-button" href="/inventory">EXPLORE VEHICLES <i class="fa-solid fa-arrow-right"></i></a><a class="dm-hero-text-link" href="<%= currentUser && (currentUser.role === 'seller' || isAdmin) ? '/seller/cars/new' : '/register' %>"><i class="fa-solid fa-circle-play"></i> Sell your car</a></div>
    </div>
  </div>
</section>
<div class="dm-container dm-search-shell" aria-label="Find vehicles">
  <div class="dm-search-tabs"><a class="active" href="/inventory"><i class="fa-solid fa-car-side"></i> Find a Car</a><a href="/recommendations"><i class="fa-solid fa-wand-magic-sparkles"></i> For You</a><a href="<%= currentUser && (currentUser.role === 'seller' || isAdmin) ? '/seller/cars/new' : '/register' %>"><i class="fa-solid fa-tags"></i> Sell Your Car</a></div>
  <form class="dm-home-search" method="get" action="/inventory">
    <label><span><i class="fa-solid fa-magnifying-glass"></i> Search Car</span><input name="search" placeholder="Brand or model" aria-label="Search brand or model"></label>
    <label><span><i class="fa-solid fa-location-dot"></i> City</span><input name="city" placeholder="Any city" aria-label="City"></label>
    <label><span><i class="fa-solid fa-money-bill-wave"></i> Min Budget (PKR)</span><input name="minPrice" type="number" min="0" placeholder="No minimum" aria-label="Minimum price in PKR"></label>
    <label><span><i class="fa-solid fa-wallet"></i> Max Budget (PKR)</span><input name="maxPrice" type="number" min="0" placeholder="Any budget" aria-label="Maximum price in PKR"></label>
    <button class="btn btn-primary dm-search-submit" type="submit"><i class="fa-solid fa-magnifying-glass"></i> SEARCH CARS</button>
  </form>
</div>
<section class="dm-highlights" aria-label="Why choose DriveMart"><div class="dm-container dm-highlights-grid">
  <div><span class="dm-highlight-icon"><i class="fa-solid fa-shield-halved"></i></span><span><strong>Verified Listings</strong><small>Seller documents reviewed before listing</small></span></div>
  <div><span class="dm-highlight-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span><span><strong>AI-Powered Insights</strong><small>Smarter car suggestions and estimates</small></span></div>
  <div><span class="dm-highlight-icon"><i class="fa-solid fa-comments"></i></span><span><strong>Direct Conversations</strong><small>Message sellers and make offers</small></span></div>
  <div><span class="dm-highlight-icon"><i class="fa-solid fa-heart"></i></span><span><strong>Save Favorites</strong><small>Keep your top picks in one place</small></span></div>
</div></section>
<section class="dm-home-section dm-featured" id="featured"><div class="dm-container">
  <div class="dm-section-head"><div><span class="dm-section-kicker">FEATURED VEHICLES</span><h2>Choose Your Perfect Car</h2><p>Explore the latest approved listings in our marketplace.</p></div><a href="/inventory" class="dm-link-more">VIEW ALL VEHICLES <i class="fa-solid fa-arrow-right"></i></a></div>
  <div class="dm-vehicle-grid">
    <% if(!featured.length){ %><div class="dm-empty-featured"><i class="fa-solid fa-car-side"></i><h3>New cars are on their way</h3><p>Check back for approved listings, or explore all available cars.</p><a href="/inventory" class="btn btn-primary">Browse inventory</a></div><% } %>
    <% featured.slice(0,4).forEach(car=>{ %>
    <article class="dm-vehicle-card">
      <div class="dm-vehicle-image"><a href="/cars/<%= car._id %>"><img src="<%= imageSrc(car.image) %>" loading="lazy" alt="<%= car.brand %> <%= car.model %>"></a><span class="dm-vehicle-type"><%= car.bodyType||'Vehicle' %></span>
      <% if(currentUser){ %><form method="post" action="/cars/<%= car._id %>/favorite" class="dm-card-favorite"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button type="submit" title="Save or remove favorite" aria-label="Save <%= car.brand %> <%= car.model %> to favorites"><i class="fa-regular fa-heart"></i></button></form><% }else{ %><a class="dm-card-favorite" href="/login" aria-label="Log in to save a car"><i class="fa-regular fa-heart"></i></a><% } %></div>
      <div class="dm-vehicle-content"><span class="dm-vehicle-brand"><%= car.brand %></span><h3><a href="/cars/<%= car._id %>"><%= car.brand %> <%= car.model %></a></h3><div class="dm-vehicle-specs"><span><i class="fa-solid fa-calendar-days"></i> <%= car.year %></span><span><i class="fa-solid fa-gauge"></i> <%= car.mileage ? formatMoney(car.mileage)+' km' : 'Mileage on request' %></span><span><i class="fa-solid fa-location-dot"></i> <%= car.city||'Pakistan' %></span></div><div class="dm-vehicle-bottom"><div><strong>PKR <%= formatMoney(car.price) %></strong><small>Asking price</small></div><a class="dm-view-car" href="/cars/<%= car._id %>">VIEW DETAILS <i class="fa-solid fa-arrow-right"></i></a></div></div>
    </article>
    <% }) %>
  </div>
</div></section>
<section class="dm-home-section dm-brands-section" id="brands"><div class="dm-container"><div class="dm-section-head"><div><span class="dm-section-kicker">EXPLORE BY BRAND</span><h2>Your Favorite Brands, All Here</h2><p>Start with the carmaker you love and discover available listings.</p></div><a href="/inventory" class="dm-link-more">BROWSE ALL <i class="fa-solid fa-arrow-right"></i></a></div><div class="dm-brand-grid">
  <% [['Toyota','fa-car-side'],['Honda','fa-car'],['Suzuki','fa-gauge'],['BMW','fa-car-rear'],['Mercedes','fa-gauge-high'],['Audi','fa-car-side']].forEach(brand=>{ %><a href="/inventory?search=<%= encodeURIComponent(brand[0]) %>" class="dm-brand-tile"><span class="dm-brand-icon"><i class="fa-solid <%= brand[1] %>"></i></span><strong><%= brand[0] %></strong><i class="fa-solid fa-arrow-up-right-from-square"></i></a><% }) %>
</div></div></section>
<section class="dm-container dm-promo-panel" id="about"><div class="dm-promo-overlay"></div><div class="dm-promo-text"><span class="dm-section-kicker">A BETTER WAY TO BUY &amp; SELL</span><h2>Drive Your Next Chapter<br>With Confidence</h2><p>Find a car you love, learn about its details and connect directly with the seller.</p><a class="btn btn-primary" href="/inventory">FIND YOUR CAR <i class="fa-solid fa-arrow-right"></i></a></div><div class="dm-promo-points"><div><i class="fa-solid fa-shield-halved"></i><b>Listing Reviews</b><small>Admin verification workflow</small></div><div><i class="fa-solid fa-comments-dollar"></i><b>Direct Offers</b><small>Chat and negotiate</small></div><div><i class="fa-solid fa-wand-magic-sparkles"></i><b>AI Car Tools</b><small>Scanning and price estimates</small></div><div><i class="fa-solid fa-calendar-check"></i><b>Easy Booking</b><small>Request a visit online</small></div></div></section>
<section class="dm-home-section dm-services-section" id="services"><div class="dm-container"><div class="dm-section-head dm-centered"><div><span class="dm-section-kicker">THE DRIVEMART EXPERIENCE</span><h2>Everything You Need In One Place</h2><p>Useful tools for both buyers and sellers, with a simple end-to-end experience.</p></div></div><div class="dm-service-grid"><a href="/inventory"><span><i class="fa-solid fa-magnifying-glass-chart"></i></span><h3>Search &amp; Compare</h3><p>Find cars by city, price, year, body type and more.</p><span class="dm-service-link">Explore listings <i class="fa-solid fa-arrow-right"></i></span></a><a href="/seller"><span><i class="fa-solid fa-file-circle-check"></i></span><h3>Sell Your Car</h3><p>Create your listing, upload photos and request verification.</p><span class="dm-service-link">Seller portal <i class="fa-solid fa-arrow-right"></i></span></a><a href="/recommendations"><span><i class="fa-solid fa-wand-magic-sparkles"></i></span><h3>Personalized Picks</h3><p>Find relevant cars based on your interests and saved listings.</p><span class="dm-service-link">See recommendations <i class="fa-solid fa-arrow-right"></i></span></a></div></div></section>
<section class="dm-faq-section" id="faq"><div class="dm-container dm-faq-layout"><div><span class="dm-section-kicker">FREQUENTLY ASKED QUESTIONS</span><h2>Buying A Car?<br>We Can Help.</h2><p>Quick answers about DriveMart's core marketplace features.</p><a href="/inventory" class="btn btn-primary">EXPLORE CARS</a></div><div class="dm-faq-questions"><details><summary>How do I book a vehicle viewing?<i class="fa-solid fa-plus"></i></summary><p>Choose an available car, select Book Now and submit a preferred visit date. An administrator reviews the request.</p></details><details><summary>How can I sell my car?<i class="fa-solid fa-plus"></i></summary><p>Create a seller account, open Seller Garage and submit vehicle details and verification documents. Admin approval is required for public visibility.</p></details><details><summary>Can I chat with sellers?<i class="fa-solid fa-plus"></i></summary><p>Yes. Open an approved seller's listing and choose Chat with Seller to send messages or make an offer.</p></details><details><summary>Are AI price estimates guaranteed?<i class="fa-solid fa-plus"></i></summary><p>No. AI-generated values are indicative suggestions, not verified quotations or professional appraisals.</p></details></div></div></section>
<section class="dm-container dm-newsletter" id="newsletter"><div class="dm-newsletter-icon"><i class="fa-regular fa-envelope-open"></i></div><div><h3>Stay In The Driver's Seat</h3><p>Get updates about new listings and car discoveries.</p></div><form method="post" action="/subscribe"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label class="sr-only" for="dm-newsletter-email">Your email address</label><input id="dm-newsletter-email" type="email" name="email" placeholder="Enter your email address" required><button type="submit" class="btn btn-primary">SUBSCRIBE <i class="fa-solid fa-arrow-right"></i></button></form></section>
</main>
<%- include('partials/footer') %>
