<%- include('partials/header') %><section class="page-section feature-panel"><h1><%= sellerView?'Received Bids':'My Bids' %></h1><% if(!bids.length){ %><p>No bids found.</p><% } %><% bids.forEach(b=>{ %><article style="padding:15px;border-bottom:1px solid #ddd"><strong><%= b.car?b.car.brand+' '+b.car.model:'Removed car' %></strong> — PKR <%= formatMoney(b.amount) %> | <%= b.status %><% if(sellerView){ %><p>Buyer: <%= b.buyer?.name || 'Unknown' %></p><% if(b.status==='pending'){ %><form method="post" action="/seller/bids/<%= b._id %>/decision"><input name="csrf_token" type="hidden" value="<%= csrfToken %>"><button name="status" value="accepted" class="btn btn-primary">Accept</button> <button name="status" value="rejected" class="btn btn-secondary">Reject</button></form><% } %><% } %></article><% }) %></section><%- include('partials/footer') %>