<%- include('partials/header') %><section class="page-section feature-panel"><h1>Set New Password</h1><% if(error){ %><p role="alert"><%= error %></p><% } %><form method="post" class="app-form"><input name="csrf_token" type="hidden" value="<%= csrfToken %>"><label>New password<input type="password" name="password" minlength="8" maxlength="128" required autocomplete="new-password"></label><button class="btn btn-primary">Change Password</button></form></section><%- include('partials/footer') %>