<%- include('partials/header') %><section class="page-section"><div class="page-heading"><span>Buyer Tools</span><h1>Saved Cars</h1><p>Keep your shortlist in one place.</p></div><div class="inventory-grid"><% if(!cars.length){ %><div class="empty-state">No favorites yet. <a href="/inventory">Explore cars</a>.</div><% } %><% cars.forEach(car=>{ %><article class="inventory-card"><img class="enhanced-card-image" src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><div class="inventory-content"><h2><%= car.brand %> <%= car.model %></h2><p>PKR <%= formatMoney(car.price) %></p><div class="card-actions"><a href="/cars/<%= car._id %>" class="btn btn-primary">View Car</a><form action="/cars/<%= car._id %>/favorite" method="post"><input name="csrf_token" type="hidden" value="<%= csrfToken %>"><button class="btn btn-secondary">Remove</button></form></div></div></article><% }) %></div></section><%- include('partials/footer') %>
