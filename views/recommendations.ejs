<%- include('partials/header') %><section class="page-section"><div class="page-heading"><span>Recommendations</span><h1>Cars For You</h1><p>Suggestions based on saved cars, recently viewed models, price ranges and city. New users see recently listed options.</p></div><div class="inventory-grid"><% cars.forEach(car=>{ %><article class="inventory-card"><img class="enhanced-card-image" src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><div class="inventory-content"><h2><%= car.brand %> <%= car.model %></h2><p><%= car.city||'Pakistan' %> • <%= car.year %> • PKR <%= formatMoney(car.price) %></p><a class="btn btn-primary" href="/cars/<%= car._id %>">View Details</a></div></article><% }) %><% if(!cars.length){ %><p>No approved available vehicles yet.</p><% } %></div></section><%- include('partials/footer') %>
