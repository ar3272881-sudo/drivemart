<%- include('partials/header') %><section class="page-section feature-panel"><h1>My Conversations</h1><% if(!rows.length){ %><p>No chats yet. Open a seller's approved car listing to start a chat.</p><% } %><% rows.forEach(row=>{ %><p><a href="/chat/<%= row.car._id %>?buyer=<%= row.buyer?._id %>"><%= row.car.brand %> <%= row.car.model %> — <%= row.buyer?.name || 'Buyer' %></a> <small><%= row.last %></small></p><% }) %></section><%- include('partials/footer') %>