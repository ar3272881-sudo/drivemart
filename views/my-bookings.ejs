<%- include('partials/header') %><section class="page-section"><div class="page-heading"><span>My Account</span><h1>My Bookings</h1><p>Track the status of every booking request.</p></div><div class="booking-list"><% if (!bookings.length) { %><div class="empty-state"><i class="fa-regular fa-calendar-xmark"></i><h2>No bookings yet</h2><p>Choose a car from the inventory to create your first booking.</p><a class="btn btn-primary" href="/inventory">Browse Cars</a></div><% } %><% bookings.forEach((booking) => { const car = booking.car; %><article class="booking-item"><img src="<%= imageSrc(car?.image) %>" alt="<%= car ? car.brand+' '+car.model : 'Deleted car' %>"><div class="booking-item-content"><div class="booking-title-row"><div><span class="brand-label"><%= car?.brand || 'Deleted' %></span><h2><%= car?.model || 'Car' %> <% if (car) { %>(<%= car.year %>)<% } %></h2></div><span class="status-badge status-<%= booking.status %>"><%= booking.status[0].toUpperCase()+booking.status.slice(1) %></span></div><div class="booking-info-grid"><p><span>Price</span>PKR <%= formatMoney(car?.price || 0) %></p><p><span>Phone</span><%= booking.phone %></p><p><span>Preferred date</span><%= formatDate(booking.preferredDate) %></p><p><span>Submitted</span><%= formatDate(booking.createdAt, true) %></p></div><% if (['pending','approved'].includes(booking.status)) { %><form method="post" action="/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Cancel this booking?');"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-danger" type="submit">Cancel Booking</button></form><% } %></div></article><% }) %></div></section><%- include('partials/footer') %>
