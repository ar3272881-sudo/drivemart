<%- include('partials/header') %><section class="page-section feature-panel"><h1>Forgot Password</h1><p>Choose a secure reset link or a six-digit email code. Both require the account's registered email.</p><form method="post" class="app-form"><input name="csrf_token" type="hidden" value="<%= csrfToken %>"><label>Email<input type="email" name="email" required></label><button class="btn btn-primary">Request reset</button></form><hr><h2>Or reset with a six-digit code</h2><form method="post" action="/forgot-password/otp" class="app-form"><input name="csrf_token" type="hidden" value="<%= csrfToken %>"><label>Email<input type="email" name="email" required></label><button class="btn btn-secondary">Email Me a Code</button></form><p><a href="/reset-password-otp">Already have a code?</a></p></section><%- include('partials/footer') %>