<%- include('partials/header') %><section class="page-section feature-panel"><h1>FR10 — User & Listing Moderation</h1><h2>User accounts</h2><table class="app-table"><tr><th>User</th><th>Role</th><th>Status</th><th>Action</th></tr><% users.forEach(u=>{ %><tr><td><%= u.name %> (<%= u.email %>)</td><td><%= u.role %></td><td><%= u.suspended?'Suspended':'Active' %></td><td><% if(u.role!=='admin'){ %><form method="post" action="/admin/moderation/users/<%= u._id %>"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-secondary" name="suspended" value="<%= u.suspended?'false':'true' %>"><%= u.suspended?'Reactivate':'Suspend' %></button></form><% } %></td></tr><% }) %></table><h2>Car Listings</h2><table class="app-table"><tr><th>Car</th><th>Visibility</th><th>Action</th></tr><% cars.forEach(c=>{ %><tr><td><%= c.brand %> <%= c.model %></td><td><%= c.hiddenByAdmin?'Hidden':'Visible' %></td><td><form method="post" action="/admin/moderation/cars/<%= c._id %>"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-secondary" name="hidden" value="<%= c.hiddenByAdmin?'false':'true' %>"><%= c.hiddenByAdmin?'Unhide':'Hide' %></button></form></td></tr><% }) %></table></section><%- include('partials/footer') %>