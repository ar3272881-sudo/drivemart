<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Drive Mart' %></title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css">
  <link rel="stylesheet" href="/drivemart.css">
  <link rel="stylesheet" href="/chatbot.css">
</head>
<body class="<%= bodyClass || '' %>">
<div class="top-bar">
  <div class="left"><a href="tel:+923001234567"><i class="fa-solid fa-phone"></i> +92 300 1234567</a>&nbsp;&nbsp;<a href="mailto:info@drivemart.com"><i class="fa-solid fa-envelope"></i> info@drivemart.com</a></div>
  <div class="right"><a href="/#about">About</a><a href="/#contact">Contact</a><a href="/#faq">FAQ</a></div>
</div>
<header class="site-header">
  <a class="logo" href="/">Drive <span>Mart</span></a>
  <nav id="primary-navigation" aria-label="Main navigation">
    <a href="/#home">Home</a><a href="/inventory">Inventory</a><a href="/#featured">Luxury Cars</a><a href="/#brands">Brands</a><a href="/#services">Services</a><a href="/#contact">Contact</a>
    <% if (currentUser) { %>
      <a href="/dashboard">Welcome, <%= currentUser.name %></a><a href="/bookings">My Bookings</a>
      <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
      <form method="post" action="/logout" class="nav-inline-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button type="submit">Logout</button></form>
    <% } else { %><a href="/login">Login</a><a href="/register">Register</a><% } %>
  </nav>
  <div class="nav-icons" aria-label="Quick links"><a href="/inventory" title="Search cars"><i class="fa-solid fa-magnifying-glass"></i></a><a href="/bookings" title="My bookings"><i class="fa-regular fa-heart"></i></a><a href="<%= currentUser ? '/dashboard' : '/login' %>" title="Account"><i class="fa-regular fa-user"></i></a></div>
  <button class="mobile-menu-toggle" type="button" aria-label="Open menu" aria-controls="primary-navigation" aria-expanded="false">
    <i class="fa-solid fa-bars" aria-hidden="true"></i>
  </button>
</header>
<% if (flash) { %><div class="flash-message flash-<%= flash.type || 'info' %>" role="alert"><%= flash.message || '' %></div><% } %>
