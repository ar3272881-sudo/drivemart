<%- include('partials/header') %><section class="page-section"><div class="page-heading split-heading"><div><span>Administration</span><h1>All Bookings</h1><p>Approve, reject, or remove customer booking requests.</p></div><a class="btn btn-secondary" href="/admin">Back to Dashboard</a></div><form method="get" class="filter-bar compact-filter"><select name="status"><option value="">All statuses</option><% allowed.forEach((option) => { %><option value="<%= option %>" <%= status === option ? 'selected' : '' %>><%= option[0].toUpperCase()+option.slice(1) %></option><% }) %></select><button class="btn btn-primary" type="submit">Filter</button><a class="btn btn-secondary" href="/admin/bookings">Reset</a></form><div class="table-panel"><div class="table-scroll"><table class="app-table"><thead><tr><th>ID</th><th>Customer</th><th>Car</th><th>Phone</th><th>Preferred Date</th><th>Status</th><th>Actions</th></tr></thead><tbody><% if (!bookings.length) { %><tr><td colspan="7">No bookings found.</td></tr><% } %><% bookings.forEach((row) => { %><tr><td>#<%= row.legacyId || String(row._id).slice(-6).toUpperCase() %></td><td><strong><%= row.user?.name || 'Deleted user' %></strong><small><%= row.user?.email || '' %></small></td><td><%= row.car ? row.car.brand+' '+row.car.model : 'Deleted car' %></td><td><%= row.phone %></td><td><%= formatDate(row.preferredDate) %></td><td><span class="status-badge status-<%= row.status %>"><%= row.status[0].toUpperCase()+row.status.slice(1) %></span></td><td><div class="table-actions"><% if (row.status !== 'approved') { %><form method="post" action="/admin/bookings/<%= row._id %>/status"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="status" value="approved"><button class="mini-btn approve" type="submit">Approve</button></form><% } %><% if (row.status !== 'rejected') { %><form method="post" action="/admin/bookings/<%= row._id %>/status"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="status" value="rejected"><button class="mini-btn reject" type="submit">Reject</button></form><% } %><form method="post" action="/admin/bookings/<%= row._id %>/delete" onsubmit="return confirm('Delete this booking permanently?');"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="mini-btn delete" type="submit">Delete</button></form></div></td></tr><% }) %></tbody></table></div></div></section><%- include('partials/footer') %>
