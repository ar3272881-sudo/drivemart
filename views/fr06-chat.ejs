<%- include('partials/header') %><section class="page-section feature-panel"><h1>Car chat: <%= car.brand %> <%= car.model %></h1><p>Messages update every 4 seconds while this page is open.</p><div id="messages" style="min-height:150px;max-height:450px;overflow:auto;border:1px solid #ddd;padding:14px" role="log"></div><form id="chatForm" class="app-form"><input id="chatText" placeholder="Message seller / buyer" maxlength="1500" required><button class="btn btn-primary">Send</button></form><p id="chatError" role="alert"></p></section><script>
(()=>{const box=document.getElementById('messages'), form=document.getElementById('chatForm'),input=document.getElementById('chatText'),error=document.getElementById('chatError');const url='/chat/<%= car._id %>/messages?buyer=<%= buyer %>';let last='';async function update(){try{const r=await fetch(url,{credentials:'same-origin'});if(!r.ok)throw Error('Could not load messages');const data=await r.json();const signature=JSON.stringify(data.messages);if(signature===last)return;last=signature;box.replaceChildren();for(const m of data.messages){const line=document.createElement('p');const name=document.createElement('strong');name.textContent=m.sender==='<%= me %>'?'You: ':'Them: ';line.append(name,document.createTextNode(m.body));box.append(line)}box.scrollTop=box.scrollHeight;error.textContent=''}catch(e){error.textContent=e.message}}form.addEventListener('submit',async e=>{e.preventDefault();const body=input.value.trim();if(!body)return;try{const r=await fetch(url,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','x-csrf-token':'<%= csrfToken %>'},body:JSON.stringify({body,buyer:'<%= buyer %>'})});if(!r.ok)throw Error('Could not send');input.value='';await update()}catch(e){error.textContent=e.message}});update();setInterval(update,4000)})()
</script><%- include('partials/footer') %>