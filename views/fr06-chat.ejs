<%- include('partials/header') %><section class="page-section feature-panel">
<div class="page-heading left-heading"><span>Buyer–Seller Messages</span><h1>Chat: <%= car.brand %> <%= car.model %></h1><p>Private conversation for this vehicle. Never send passwords or payment credentials.</p></div>
<p class="chat-live-state" id="chatLiveState">Connecting to live updates…</p>
<div id="messages" style="min-height:200px;max-height:440px;overflow-y:auto;border:1px solid #ddd;padding:15px;border-radius:8px" role="log" aria-live="polite"></div>
<form id="chatForm" class="app-form"><label>Message<input id="chatText" maxlength="1500" placeholder="Type a message..." required></label><button class="btn btn-primary">Send Message</button></form>
<div id="chatError" role="alert"></div><section class="bid-pane"><h2>Offers on this vehicle</h2><div id="threadBids"><p>Loading bids…</p></div><% if(me!==seller){ %><form id="threadBidForm" class="app-form" method="post" action="/cars/<%= car._id %>/bids"><input name="csrf_token" type="hidden" value="<%= csrfToken %>"><label>Offer (PKR)<input name="amount" min="1" max="10000000000" step="1" type="number" required></label><button class="btn btn-primary">Make an Offer</button></form><% }else{ %><p>Accept or reject offers from <a href="/seller/bids">Received Bids</a>.</p><% } %></section>
</section><script>
(()=>{const box=document.getElementById('messages'),form=document.getElementById('chatForm'),input=document.getElementById('chatText'),error=document.getElementById('chatError'),state=document.getElementById('chatLiveState');
const url='/chat/<%= car._id %>/messages?buyer=<%= buyer %>';let last='';
async function update(){try{const r=await fetch(url,{credentials:'same-origin'});if(!r.ok)throw Error('Could not load messages');const data=await r.json();const signature=JSON.stringify(data.messages);if(signature===last)return;last=signature;box.replaceChildren();for(const m of data.messages){const line=document.createElement('p');const name=document.createElement('strong');name.textContent=m.sender==='<%= me %>'?'You: ':'Other person: ';line.append(name,document.createTextNode(m.body));box.append(line)}box.scrollTop=box.scrollHeight;error.textContent=''}catch(e){error.textContent=e.message}}
async function updateBids(){try{const r=await fetch('/chat/<%= car._id %>/bids?buyer=<%= buyer %>',{credentials:'same-origin'});if(!r.ok)return;const data=await r.json();const parent=document.getElementById('threadBids');parent.replaceChildren();if(!data.bids.length){parent.textContent='No offers yet.';return;}for(const b of data.bids){const div=document.createElement('div');div.className='bid-mini';div.textContent=`PKR ${Number(b.amount).toLocaleString('en-PK')} • ${b.status}`;parent.append(div)}}catch(e){}}
form.addEventListener('submit',async e=>{e.preventDefault();const body=input.value.trim();if(!body)return;const button=form.querySelector('button');button.disabled=true;try{const r=await fetch(url,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','x-csrf-token':'<%= csrfToken %>'},body:JSON.stringify({body,buyer:'<%= buyer %>'})});if(!r.ok)throw Error('Could not send');input.value='';await update()}catch(e){error.textContent=e.message}finally{button.disabled=false}});
let stream;let fallback;function polling(){if(fallback)return;state.textContent='Live connection unavailable; refreshing periodically.';fallback=setInterval(()=>{if(!document.hidden){update();updateBids()}},5000)}
if(window.EventSource){stream=new EventSource('/events');stream.addEventListener('open',()=>{state.textContent='Live updates connected';if(fallback){clearInterval(fallback);fallback=null}});stream.addEventListener('update',event=>{try{const data=JSON.parse(event.data);if(data.type==='message')update();if(data.type==='bid')updateBids()}catch(e){}});stream.onerror=()=>polling()}else polling();
window.addEventListener('beforeunload',()=>{stream?.close();if(fallback)clearInterval(fallback)});update();updateBids();})();
</script><%- include('partials/footer') %>
