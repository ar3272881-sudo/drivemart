<%- include('partials/header') %><section class="page-section">
<div class="page-heading split-heading"><div><span>Seller Portal</span><h1>My Garage</h1><p>Manage your car listings, track page views, and follow admin approval.</p></div><a class="btn btn-primary" href="/seller/cars/new">+ Submit Car</a></div>
<div class="inventory-grid"><% if(!cars.length){ %><div class="empty-state"><h2>No cars yet</h2><a href="/seller/cars/new" class="btn btn-primary">Submit First Car</a></div><% } %>
<% cars.forEach(car=>{ %><article class="inventory-card"><div class="inventory-image"><img src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><span class="status-badge status-<%= car.approvalStatus %>"><%= car.approvalStatus %></span></div><div class="inventory-content">
<h2><%= car.brand %> <%= car.model %></h2><p><%= car.year %> • PKR <%= formatMoney(car.price) %> • <%= car.status %></p><p><strong><%= car.views||0 %></strong> views • <%= car.analytics?.saves||0 %> saved • <%= car.analytics?.bids||0 %> offers • <%= car.analytics?.messages||0 %> messages</p>
<% if(car.approvalStatus==='rejected'){ %><p class="review-note">Review note: <%= car.verificationNotes %></p><% } %>
<div class="card-actions"><% if(car.approvalStatus==='approved'){ %><a class="btn btn-secondary" href="/cars/<%= car._id %>">View</a><% } %>
<% if(car.status!=='sold'){ %><a class="btn btn-secondary" href="/seller/cars/<%= car._id %>/edit">Edit <%= car.approvalStatus==='rejected'?'& Resubmit':'' %></a><% } %>
<% if(car.approvalStatus==='approved'&&car.status==='available'){ %><form method="post" action="/seller/cars/<%= car._id %>/sold" onsubmit="return confirm('Mark this car sold?');"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-primary">Mark Sold</button></form><% } %>
<form method="post" action="/seller/cars/<%= car._id %>/delete" onsubmit="return confirm('Permanently delete this listing and its activity?');"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="btn btn-danger">Delete</button></form></div>
</div></article><% }) %></div></section><%- include('partials/footer') %>
