<%- include('partials/header') %><section class="auth-shell"><div class="auth-card"><div class="auth-heading"><span>Create your account</span><h1>Join Drive Mart</h1><p>Register to book premium cars and track your requests.</p></div><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="post" class="app-form" novalidate><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Full Name<input type="text" name="name" value="<%= values.name %>" maxlength="100" required autocomplete="name"></label><label>Email Address<input type="email" name="email" value="<%= values.email %>" maxlength="150" required autocomplete="email"></label><label>Password<input type="password" name="password" minlength="8" required autocomplete="new-password"></label><label>Confirm Password<input type="password" name="confirm_password" minlength="8" required autocomplete="new-password"></label><button class="btn btn-primary btn-block" type="submit">Create Account</button></form><p class="auth-switch">Already have an account? <a href="/login">Login</a></p></div></section><%- include('partials/footer') %>
