<%- include('partials/header') %><section class="page-section compact-section"><div class="page-heading"><span>My Account</span><h1>Welcome, <%= currentUser.name %> 🚗</h1><p>You are logged in as <%= currentUser.email %>.</p></div><div class="dashboard-grid"><article class="dashboard-panel"><h2><%= activeBookings %></h2><p>Active bookings</p><a class="btn btn-primary" href="/bookings">View My Bookings</a></article><article class="dashboard-panel"><i class="fa-solid fa-car-side"></i><h3>Find your next car</h3><p>Browse all available vehicles and open full details.</p><a class="btn btn-secondary" href="/inventory">Browse Inventory</a></article><% if (currentUser.role === 'seller' || isAdmin) { %><article class="dashboard-panel"><i class="fa-solid fa-file-circle-plus"></i><h3>Seller Portal</h3><p>Submit cars and track approval requests.</p><a class="btn btn-primary" href="/seller">My Listings</a></article><% } %><% if (isAdmin) { %><article class="dashboard-panel"><i class="fa-solid fa-user-shield"></i><h3>Administration</h3><p>Manage cars, customers, and booking requests.</p><a class="btn btn-secondary" href="/admin">Admin Dashboard</a></article><% } %></div><section class="enhanced-recommendations"><h2>Recommended for You</h2><p>Based on your browsing and saved cars</p><div class="inventory-grid"><% recommended.forEach(car=>{ %><article class="inventory-card"><img class="enhanced-card-image" src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><div class="inventory-content"><h3><%= car.brand %> <%= car.model %></h3><p>PKR <%= formatMoney(car.price) %></p><a href="/cars/<%= car._id %>" class="btn btn-secondary">View Car</a></div></article><% }) %></div><p><a class="btn btn-primary" href="/recommendations">See All Recommendations</a> <a class="btn btn-secondary" href="/favorites">Saved Cars</a></p></section></section><%- include('partials/footer') %>
