<%- include('partials/header') %><section class="page-section compact-section"><div class="booking-layout"><article class="booking-car-summary"><img src="<%= imageSrc(car.image) %>" alt="<%= car.brand %> <%= car.model %>"><span class="brand-label"><%= car.brand %></span><h2><%= car.model %> (<%= car.year %>)</h2><p class="detail-price">PKR <%= formatMoney(car.price) %></p></article><div class="form-panel"><div class="page-heading left-heading"><span>Booking Request</span><h1>Confirm Your Details</h1><p>Your request will remain pending until an admin approves it.</p></div><% if (error) { %><div class="form-error"><%= error %></div><% } %><form method="post" class="app-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Name<input type="text" value="<%= currentUser.name %>" readonly></label><label>Email<input type="email" value="<%= currentUser.email %>" readonly></label><label>Phone Number<input type="tel" name="phone" value="<%= values.phone %>" maxlength="20" required placeholder="+92 300 1234567"></label><label>Preferred Visit Date<input type="date" name="preferred_date" value="<%= values.preferred_date %>" min="<%= todayInput() %>" required></label><button class="btn btn-primary btn-block" type="submit">Submit Booking</button></form></div></div></section><%- include('partials/footer') %>
