PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/drivemart
SESSION_SECRET=replace_with_a_long_random_secret

# Required for car image uploads on Vercel/production.
# Recommended: copy the complete API Environment Variable from Cloudinary.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Alternative: use these three variables instead of CLOUDINARY_URL.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
