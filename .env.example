# Copy this file to .env locally. Never commit your real .env file.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/drivemart
SESSION_SECRET=replace-with-long-unique-random-session-secret
JWT_SECRET=replace-with-different-long-random-jwt-secret
DOCUMENT_SECRET=replace-with-long-unique-stable-document-encryption-secret

# Gemini AI scan, price estimation and budget-aware chatbot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary is recommended for persistent car photos on Vercel/serverless hosting.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail delivery through a Google Apps Script Web App (no Nodemailer needed).
# The script sends mail from the Gmail account that owns the Apps Script deployment.
GMAIL_APPS_SCRIPT_URL=
GMAIL_APPS_SCRIPT_SECRET=
GMAIL_FROM_NAME=DriveMart

# Used to hash OTPs and protect password-recovery tokens.
EMAIL_OTP_SECRET=replace-with-another-independent-long-random-secret
PUBLIC_BASE_URL=http://localhost:3000

# Set true only after the Gmail Apps Script relay test email succeeds.
REQUIRE_EMAIL_VERIFICATION=false

# SSE works on persistent Node servers. Vercel serverless uses polling fallback.
DISABLE_SSE=false
