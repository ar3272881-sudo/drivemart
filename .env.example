# Copy this file to .env and add your real private values. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/drivemart
SESSION_SECRET=replace-with-long-unique-random-session-secret
JWT_SECRET=replace-with-different-long-unique-random-jwt-secret
DOCUMENT_SECRET=replace-with-long-unique-stable-document-encryption-secret

# Gemini AI scan, price estimation and car recommendation chatbot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary is strongly recommended for hosted and serverless deployments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email links and six-digit OTP (Resend). Required to send password reset links.
# Email OTP requires all three: RESEND_API_KEY, RESET_FROM_EMAIL, EMAIL_OTP_SECRET.
RESEND_API_KEY=
RESET_FROM_EMAIL=
PUBLIC_BASE_URL=http://localhost:3000
EMAIL_OTP_SECRET=replace-with-another-independent-long-secret

# Optional: force newly registered users to verify their email via OTP.
# Keep false until Resend is configured. Existing user accounts are grandfathered.
REQUIRE_EMAIL_VERIFICATION=false

# SSE works on persistent Node servers. Vercel serverless automatically uses polling fallback.
DISABLE_SSE=false
