PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/drivemart
SESSION_SECRET=replace_with_a_long_random_secret

# Optional: required only for permanent image uploads on Vercel/production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FR01: JWT signing secret; use another long, random 32+ character value.
JWT_SECRET=replace_with_a_separate_long_random_secret

# FR03 + FR04: Gemini AI key (optional for non-AI pages). Never expose in frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Recommended: separate encryption secret for private identity documents.
DOCUMENT_SECRET=replace_with_another_long_random_secret
